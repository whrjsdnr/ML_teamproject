+
+def test_symlink_escape_rejected(config, tmp_path):
+    external = tmp_path.parent / (tmp_path.name + "-outside")
+    external.write_text("not an artifact")
+    path = config.artifact_root / config.lightgbm_path
+    path.unlink()
+    path.symlink_to(external)
