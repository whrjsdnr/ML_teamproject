+"""Local read-only demo: features -> registered prediction -> inference receipt.
+
+No state changes, assessor/LLM calls, tools, policy overrides or response actions.
+"""
+
+import argparse
+import asyncio
+import json
+import sys
+from pathlib import Path
+
+from soc_agent.security_ai.errors import SecurityAIError
+from soc_agent.security_ai.features import SecurityRecord, SourceReference, SourceType
+from soc_agent.security_ai.network.v4 import (
+    DeploymentProfile,
+    NetworkSecurityAIConfig,
+    Top40FeatureExtractor,
+    create_network_security_ai,
+    prediction_to_evidence,
+)
+from soc_agent.state import IncidentState
+from soc_agent.state.evidence import utc_now
+
+
+async def predict(args: argparse.Namespace) -> dict[str, object]:
+    config = NetworkSecurityAIConfig(
+        enabled=True,
+        artifact_root=args.artifact_root,
+        profile=args.profile,
+    )
+    adapter = create_network_security_ai(config)
+    assert adapter is not None
+    payload = json.loads(args.input.read_text(encoding="utf-8"))
+    if not isinstance(payload, dict):
+        raise ValueError("Input must be an object of Top40 flow features")
+    state = IncidentState()
+    record = SecurityRecord(
+        incident_id=state.incident_id,
+        record_type="cse_cic_ids2018_flow",
+        record_schema_version="1.0.0",
+        source="local-inference-demo",
+        source_reference=SourceReference(
+            source_type=SourceType.STREAM,
+            source_name="local-inference-demo",
+            record_id="demo-flow",
+        ),
+        fields=payload,
+        observed_at=utc_now(),
+    )
+    feature_set = Top40FeatureExtractor(adapter.predictor.contract).extract(record, state=state)
+    result = await adapter.as_security_ai().predict(
+        {"incident_id": state.incident_id, "input": feature_set}
+    )
+    receipt = prediction_to_evidence(result)
+    return {
+        "prediction": result.model_dump(mode="json"),
+        "evidence": receipt.model_dump(mode="json"),
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--input", type=Path, required=True)
+    parser.add_argument("--artifact-root", type=Path, required=True)
+    parser.add_argument(
+        "--profile",
+        choices=[p.value for p in DeploymentProfile],
+        default=DeploymentProfile.DETECTION_QUALITY.value,
+    )
+    args = parser.parse_args()
+    try:
+        print(json.dumps(asyncio.run(predict(args)), ensure_ascii=False, indent=2))
+    except (SecurityAIError, OSError, ValueError, TypeError) as error:
+        # Suppress raw traffic and pickle/runtime error messages.
+        print(f"Network inference demo failed: {type(error).__name__}", file=sys.stderr)
+        return 2
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
