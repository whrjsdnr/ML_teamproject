+    def loader(*args):
+        if fails:
+            raise RuntimeError("sensitive backend detail")
+        return booster
+
+    monkeypatch.setattr(module, "load_lightgbm", loader)
+    state = IncidentState()
+    before = state.model_dump_json()
+    adapter = NetworkSecurityAIAdapter(module.LightGBMNetworkThreatPredictor(config, contract))
+    feature_set = Top40FeatureExtractor(contract).extract(
+        source_record(state, features), state=state
+    )
+    wrapper = adapter.as_security_ai()
+    registry = SecurityAIRegistry()
+    registry.register(wrapper)
+    metadata = wrapper.metadata
+    step = SecurityAISelectionStep(
+        model_name=metadata.name,
+        model_version=metadata.version,
+        task_type=metadata.task_type,
+        input_type=metadata.input_type,
+        model_input=feature_set.model_dump(mode="json"),
+        purpose="Inspect model-derived network context",
+    )
+    plan = SecurityAISelectionPlan(
+        incident_id=state.incident_id,
+        decision="run_ai",
+        goal="Network assessment input",
+        reason="Explicit trusted application composition",
+        steps=(step,),
+    )
+    output = await SecurityAIInvestigator(registry=registry).execute(
+        incident=state,
+        selection_plan=plan,
+    )
+    assert state.model_dump_json() == before
