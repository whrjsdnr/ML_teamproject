diff --git a/src/soc_agent/security_ai/network/v4/adapter.py b/src/soc_agent/security_ai/network/v4/adapter.py
new file mode 100644
--- /dev/null
+++ b/src/soc_agent/security_ai/network/v4/adapter.py
@@ -0,0 +1,130 @@
+"""Reuse SecurityAI, FeatureSet and Evidence; prediction records are not attack facts."""
+
+import asyncio
+from dataclasses import dataclass
+
+from soc_agent.security_ai.base import SecurityAI
+from soc_agent.security_ai.enums import SecurityAIInputType, SecurityAITaskType
+from soc_agent.security_ai.errors import SecurityAIInputValidationError
+from soc_agent.security_ai.features import FeatureSet, SecurityRecord, create_feature_set
+from soc_agent.security_ai.models import (
+    SecurityAIModelMetadata,
+    SecurityAIPrediction,
+    SecurityAIRequest,
+)
+from soc_agent.security_ai.network.v4.contracts import (
+    DeploymentProfile,
+    NetworkSecurityAIConfig,
+    NetworkThreatPredictor,
+    Top40Contract,
+)
+from soc_agent.security_ai.network.v4.predictors import (
+    DNNNetworkThreatPredictor,
+    LightGBMNetworkThreatPredictor,
+)
+from soc_agent.state import IncidentState
+
+
+@dataclass(frozen=True)
+class Top40FeatureExtractor:
+    """Accept precomputed CIC-IDS2018 flow features, not packets or CICIDS2017 rows."""
+
+    contract: Top40Contract
+
+    def extract(self, record: SecurityRecord, *, state: IncidentState | None = None) -> FeatureSet:
+        if record.record_type != "cse_cic_ids2018_flow" or record.record_schema_version != "1.0.0":
+            raise SecurityAIInputValidationError("Expected versioned CSE-CIC-IDS2018 flow record")
+        return create_feature_set(
+            feature_schema=self.contract.schema,
+            values=self.contract.payload(record.payload()),
+            records=(record,),
+            extractor_name="cse_cic_ids2018_top40",
+            extractor_version="1.0.0",
+            state=state,
+        )
+
+
+@dataclass(frozen=True)
+class NetworkSecurityAIAdapter:
+    """Registered read-only local model handler. No execution/state/approval dependency."""
+
+    predictor: NetworkThreatPredictor
+
+    async def __call__(self, request: SecurityAIRequest[FeatureSet]) -> SecurityAIPrediction:
+        feature_set = FeatureSet.model_validate(request.input.model_dump())
+        provenance = feature_set.provenance
+        if (
+            feature_set.feature_schema != self.predictor.contract.schema
+            or provenance.extractor_name != "cse_cic_ids2018_top40"
+            or provenance.extractor_version != "1.0.0"
+            or provenance.incident_id not in (None, request.incident_id)
+            or len(provenance.sources) != 1
+            or any(
+                s.record_type != "cse_cic_ids2018_flow" or s.record_schema_version != "1.0.0"
+                for s in provenance.sources
+            )
+        ):
+            raise SecurityAIInputValidationError("Feature schema/extraction provenance differs")
+        # CPU inference must not block the agent's async investigation loop.
+        prediction = await asyncio.to_thread(self.predictor.predict, feature_set.input_payload())
+        return SecurityAIPrediction(
+            prediction=prediction.predicted_class,
+            confidence=prediction.confidence,
+            scores={
+                "class_probabilities": {
+                    p.label: p.probability for p in prediction.class_probabilities
+                },
+                "threat_score": prediction.threat_score,
+            },
+            explanation={
+                "type": "network_threat_prediction",
+                "model_derived": True,
+                "confidence_calibrated": False,
+                "confidence_semantics": "raw argmax probability",
+                "threat_score_semantics": "1 - P(Benign); uncalibrated model output",
+                "class_id": prediction.class_id,
+                "deployment_profile": prediction.deployment_profile.value,
+                "feature_set_version": prediction.feature_set_version,
+                "feature_contract_digest": prediction.feature_contract_digest,
+                "label_mapping_digest": prediction.label_mapping_digest,
+                "model_artifact_digest": self.predictor.contract.artifact_digests[
+                    "lightgbm_path"
+                    if prediction.deployment_profile is DeploymentProfile.DETECTION_QUALITY
+                    else "dnn_path"
+                ],
+                "feature_fingerprint": feature_set.input_fingerprint,
+                "source_evidence_ids": [str(i) for i in provenance.source_evidence_ids],
+                "inferred_at": prediction.inferred_at.isoformat(),
+                "inference_latency_ms": prediction.inference_latency_ms,
+                "latency_scope": "backend_call_including_preprocessing_and_cold_load",
+                "dataset": "CSE-CIC-IDS2018",
+                "evaluation_scope": "development validation",
+            },
+        )
+
+    def as_security_ai(self) -> SecurityAI[FeatureSet]:
+        return SecurityAI(
+            metadata=SecurityAIModelMetadata(
+                name=self.predictor.model_name,
+                version=self.predictor.model_version,
+                description="CSE-CIC-IDS2018 V4 model-derived context; not operational approval",
+                task_type=SecurityAITaskType.CLASSIFICATION,
+                input_type=SecurityAIInputType.NETWORK_FLOW,
+            ),
+            input_model=FeatureSet,
+            handler=self,
+        )
+
+
+def create_network_security_ai(config: NetworkSecurityAIConfig) -> NetworkSecurityAIAdapter | None:
+    """Opt-in trusted composition. Select one backend, never fallback or ensemble."""
+    config = NetworkSecurityAIConfig.model_validate(config.model_dump(warnings=False))
+    if not config.enabled:
+        return None
+    contract = Top40Contract(config)
+    backend = (
+        LightGBMNetworkThreatPredictor
+        if config.profile is DeploymentProfile.DETECTION_QUALITY
+        else DNNNetworkThreatPredictor
+    )
+    return NetworkSecurityAIAdapter(backend(config, contract))
