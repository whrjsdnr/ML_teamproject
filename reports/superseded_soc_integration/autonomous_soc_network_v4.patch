+"""Flow -> registered prediction -> inference receipt -> advisory assessment, never response."""
+
+import json
+
+import pytest
+from pydantic import BaseModel
+
+from soc_agent.approval import ApprovalManager
+from soc_agent.assessment import ThreatAssessor
+from soc_agent.assessment.errors import AssessmentContextTooLargeError, InvalidAssessmentDraftError
+from soc_agent.assessment.prompts import build_analysis_request
+from soc_agent.execution import ActionProposal, GovernedExecutor
+from soc_agent.execution.errors import ApprovalRequiredError, ExecutionDeniedError
+from soc_agent.llm import MockLLMClient
+from soc_agent.policy import PolicyDecision, PolicyEngine
+from soc_agent.security_ai import SecurityAIRegistry, create_ai_signal
+from soc_agent.security_ai.features import SecurityRecord, SourceReference, SourceType
+from soc_agent.security_ai.network.v4 import (
+    NetworkSecurityAIAdapter,
+    Top40FeatureExtractor,
+    prediction_to_evidence,
+)
+from soc_agent.security_ai.network.v4 import predictors as module
+from soc_agent.state import Evidence, IncidentState
+from soc_agent.state.evidence import utc_now
+from soc_agent.tools import MockTool, ToolMetadata, ToolPermission, ToolRegistry, ToolRiskLevel
+from tests.unit.security_ai.network_v4.conftest import (
+    booster as booster,
+)
+from tests.unit.security_ai.network_v4.conftest import (
+    config as config,
+)
+from tests.unit.security_ai.network_v4.conftest import (
+    contract as contract,
+)
+from tests.unit.security_ai.network_v4.conftest import (
+    features as features,
+)
+
+
+def source_record(state, features):
+    return SecurityRecord(
+        incident_id=state.incident_id,
+        record_type="cse_cic_ids2018_flow",
+        record_schema_version="1.0.0",
+        source="synthetic-flow",
+        source_reference=SourceReference(
+            source_type=SourceType.STREAM, source_name="synthetic-flow", record_id="flow-1"
+        ),
+        fields=features,
+        observed_at=utc_now(),
+    )
+
+
+async def inference_receipt(config, contract, features, booster, monkeypatch):
+    monkeypatch.setattr(module, "load_lightgbm", lambda *args: booster)
+    state = IncidentState()
+    adapter = NetworkSecurityAIAdapter(module.LightGBMNetworkThreatPredictor(config, contract))
+    flow = source_record(state, features)
+    feature_set = Top40FeatureExtractor(contract).extract(flow, state=state)
+    registry = SecurityAIRegistry()
+    registry.register(adapter.as_security_ai())
+    result = await registry.get(adapter.predictor.model_name).predict(
+        {"incident_id": state.incident_id, "input": feature_set}
+    )
+    signal = create_ai_signal(result, state=state)
+    receipt = prediction_to_evidence(result)
+    assert signal.prediction == result.prediction and not state.evidence
+    return state, receipt, result
+
+
+@pytest.mark.asyncio
+async def test_features_prediction_evidence_assessor_input(
+    config, contract, features, booster, monkeypatch
+):
+    state, receipt, result = await inference_receipt(
+        config, contract, features, booster, monkeypatch
+    )
+    payload = json.loads(receipt.raw_data)
+    assert receipt.reliability is None and receipt.source == "network_security_ai"
+    assert payload["model_derived"] and not payload["attack_confirmed"]
+    assert not payload["confidence_calibrated"]
+    for name in (
+        "model",
+        "model_version",
+        "deployment_profile",
+        "feature_set_version",
+        "class_id",
+        "inferred_at",
+        "inference_latency_ms",
+    ):
+        assert name in payload
+    assert len(receipt.raw_data) < 4096
+    assert all(n not in payload for n in contract.names)
+    assert "feature_values" not in receipt.raw_data
+    assert payload["result_id"] == str(result.result_id)
+    state = state.add_evidence(receipt)
+    llm = MockLLMClient(
+        [
+            {
+                "observations": [],
+                "hypotheses": [
+                    {
+                        "ref": "H1",
+                        "statement": "Possible attack; verify flow data",
+                        "supporting_evidence_ids": [str(receipt.evidence_id)],
+                        "confidence": 0.4,
+                    }
+                ],
+                "assessment": {
+                    "severity": "medium",
+                    "confidence": 0.4,
+                    "summary": "Uncalibrated model prediction requires investigation",
+                    "supporting_evidence_ids": [str(receipt.evidence_id)],
+                    "supporting_hypothesis_refs": ["H1"],
+                },
+            }
+        ]
+    )
+    assessment = await ThreatAssessor(llm_client=llm).assess(state)
+    assert len(assessment.incident_state.hypotheses) == 1
+    assert not assessment.incident_state.observations
+    assert state.severity == assessment.incident_state.severity  # advisory severity not promoted
+    assert "network_security_ai" in llm.requests[0].user_prompt
+    assert "NOT evidence of an attack" in llm.requests[0].system_prompt
+    assert len(booster.calls) == 1
+
+
+@pytest.mark.asyncio
+async def test_prediction_cannot_be_promoted_to_observation(
+    config, contract, features, booster, monkeypatch
+):
+    state, receipt, _ = await inference_receipt(config, contract, features, booster, monkeypatch)
+    state = state.add_evidence(receipt)
+    before = state.model_dump_json()
+    llm = MockLLMClient(
+        [
+            {
+                "observations": [
+                    {
+                        "ref": "O1",
+                        "statement": "Attack confirmed by model",
+                        "supporting_evidence_ids": [str(receipt.evidence_id)],
+                    }
+                ],
+                "hypotheses": [],
+                "assessment": {
+                    "severity": "critical",
+                    "confidence": 0.99,
+                    "summary": "Bad promotion",
+                    "supporting_evidence_ids": [str(receipt.evidence_id)],
+                },
+            }
+        ]
+    )
+    with pytest.raises(InvalidAssessmentDraftError, match="receipts cannot support"):
+        await ThreatAssessor(llm_client=llm).assess(state)
+    assert state.model_dump_json() == before
+
+
+class Target(BaseModel):
+    host: str
+
+
+class ToolOutput(BaseModel):
+    accepted: bool
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "permission",
+    [ToolPermission.NETWORK_WRITE, ToolPermission.SYSTEM_WRITE, ToolPermission.FILE_WRITE],
+)
+@pytest.mark.parametrize("risk", [ToolRiskLevel.LOW, ToolRiskLevel.HIGH, ToolRiskLevel.DESTRUCTIVE])
+async def test_high_confidence_prediction_never_grants_write_authority(
+    config, contract, features, booster, monkeypatch, permission, risk
+):
+    state, receipt, result = await inference_receipt(
+        config, contract, features, booster, monkeypatch
+    )
+    assert result.confidence == 0.99 and result.prediction != "Benign"
+    state = state.add_evidence(receipt)
+    tool = MockTool(
+        metadata=ToolMetadata(
+            name="fixture_response",
+            description="Mock only; no host changes",
+            permission=permission,
+            risk_level=risk,
+        ),
+        input_model=Target,
+        output_model=ToolOutput,
+        responses=[{"accepted": True}],
+    )
+    registry = ToolRegistry()
+    registry.register(tool.tool)
+    approvals = ApprovalManager()
+    policy = PolicyEngine()
+    executor = GovernedExecutor(registry=registry, policy=policy, approvals=approvals)
+    action = ActionProposal(
+        incident_id=state.incident_id,
+        tool_name="fixture_response",
+        tool_input={"host": "synthetic-host"},
+    )
+    assert tool.call_count == 0 and not approvals.list()
+    if risk is ToolRiskLevel.DESTRUCTIVE:
+        assert policy.evaluate(tool.tool.metadata).decision is PolicyDecision.DENY
+        with pytest.raises(ExecutionDeniedError):
+            await executor.execute(action)
+    else:
+        assert policy.evaluate(tool.tool.metadata).decision is PolicyDecision.REQUIRE_APPROVAL
+        with pytest.raises(ApprovalRequiredError):
+            await executor.execute(action)
+        request = executor.request_approval(action, reason="Human review required")
+        with pytest.raises(ApprovalRequiredError):
+            await executor.execute(action, approval_id=request.approval_id)
+    assert tool.call_count == 0  # inference/receipt never execute or approve
+
